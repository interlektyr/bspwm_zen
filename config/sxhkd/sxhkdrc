######################################
# WINDOWS
######################################
#
# configured by bspwmrc: 
#
# left mouse = select window
#
# super + left mouse drag = move window
#
# super + right mouse drag = resize window

# focus the next/previous window in the current desktop
super + Left
    bspc node -f prev.local.!hidden.window

super + Right
    bspc node -f next.local.!hidden.window

# move a floating window with your keyboard
super + alt + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

# close window with mouse
super + ctrl + button3
	bspc node -c

# kill window
super + ctrl + Delete
    bspc node -k

# hide window
super + Down
    bspc node $1 --flag sticky=on; bspc node $1 --flag hidden=on

# toggle between fullscreen and floating
super + Up
    bspc node -t "~"{fullscreen,floating}

 # toggle beetwen floating & tiled
super + ctrl + Up
    bspwm_layouts.sh 

# in tiled mode, swap the current node and the biggest window
super + ctrl + b 
	bspc node -s biggest.window

# in tiled mode, alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

######################################
# DEKTOPS 
######################################

# focus the next/previous desktop in the current monitor
super + ctrl + {Left,Right}
    bspwm_workspaces.sh {prev,next} ; bar_desk.sh s

# jump to desktop
super + {1-9}
    bspwm_workspaces.sh jump {1-9} ; bar_desk.sh s

# send window to the given desktop and follow it
super + ctrl + {1-9}
    bspwm_workspaces.sh sendf {1-9} ; bar_desk.sh s

# send window to the given desktop and stay on the current
super + alt + {1-9}
    bspwm_workspaces.sh send {1-9}

######################################
# BASIC APPS
######################################

# terminal emulator
alt + Return
   kitty 

#urxvtc -name URxvtL

# drop down terminal beta
super + Return 
    tdrop -w 50% -h 50% -x 25% -y 25% kitty

# custom launcher script
super + @space
  xdotool search --onlyvisible --classname URxvtAppC windowunmap \
    || xdotool search --classname URxvtAppc windowmap \
    || urxvtc -name URxvtAppc -e sh -c "fzf_appcommander.sh;xdotool search --onlyvisible --classname URxvtAppC windowunmap;appcommander.sh"

# zen-browser
super + z
	zen-browser https://nimplex.github.io/Minimal-StartPage/

# ranger
super + r
  urxvtc -g 120x35 -e ranger

# yazi
super + y 
  xdotool search --onlyvisible --classname kitty_yazi windowunmap \
    || xdotool search --classname kitty_yazi windowmap \
    || kitty --override initial_window_width=1800 --override initial_window_height=1200 --name kitty_yazi yazi;xdotool search --onlyvisible --classname kitty_yazi windowunmap;yazi

# neovide
super + n 
  neovide

# help
super + ctrl + h
    urxvtc -g 120x30 -e sh -c "gum pager < /$HOME/.config/sxhkd/sxhkdrc;exit"

# alternatives

# firefox
super + ctrl + f
	firejail firefox

super + f 
  firefox

# gedit
super + x
    gedit

######################################
# MENUS
######################################

# Power
super + Delete
    urxvtc -g 55x11 -e sh -c "bspwm_powergmenu.sh;exit"

# Connections
super + i
    urxvtc -g 55x12 -e sh -c "bspwm_network.sh;exit"

# System
super + s
    urxvtc -g 55x10 -e sh -c "bspwm_system.sh;exit"

# List windos mapped on current desktop
super + ctrl + @space
    urxvtc -g 120x30 -e sh -c "bspwm_navigator.sh -d;exit"

# List all mapped windows 
super + ctrl + w 
   urxvtc -g 120x30 -e sh -c "bspwm_navigator.sh -a;exit"

# Hidden windows
super + h
    urxvtc -g 120x30 -e sh -c "bspwm_navigator.sh -h;exit"

# Eject mounted drives
super + ctrl + e
    urxvtc -g 80x12 -e sh -c "bspwm_eject.sh;exit"

# Pepper - helper script for pacman/paru 
super + alt + @space
    urxvtc -g 120x30 -e sh -c "bspwm_pepper.sh;exit"


