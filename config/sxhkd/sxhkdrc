######################################
# WINDOWS
######################################
#
# configured by bspwmrc: 
#
# left mouse = select window
#
# super + left mouse drag = move window
#
# super + right mouse drag = resize window

# focus the next/previous window in the current desktop
super + Left
    bspc node -f prev.local.!hidden.window

super + Right
    bspc node -f next.local.!hidden.window

# move a floating window with your keyboard
super + alt + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

# close window with mouse
super + ctrl + button3
	bspc node -c

# kill window
super + ctrl + Delete
    bspc node -k

# hide window
super + Down
    bspc node $1 --flag sticky=on; bspc node $1 --flag hidden=on

# toggle between fullscreen and floating
super + Up
    bspc node -t "~"{fullscreen,floating}

 # toggle beetwen floating & tiled
super + ctrl + Up
    bspc node -t "~"{floating,tiled}

# in tiled mode, swap the current node and the biggest window
super + ctrl + space
	bspc node -s biggest.window

# in tiled mode, alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

######################################
# DEKTOPS 
######################################

# focus the next/previous desktop in the current monitor
super + ctrl + {Left,Right}
    bspwm_workspaces.sh {prev,next} ; bar_desk.sh s

# jump to desktop
super + {1-9}
    bspwm_workspaces.sh jump {1-9} ; bar_desk.sh s

# send window to the given desktop and follow it
super + ctrl + {1-9}
    bspwm_workspaces.sh sendf {1-9} ; bar_desk.sh s

# send window to the given desktop and stay on the current
super + alt + {1-9}
    bspwm_workspaces.sh send {1-9}

######################################
# BASIC APPS
######################################

# spawn terminal as a scratchpad (using tdrop)
super + Return
	tdrop -w 50% -h 50% -x 25% -y 25% urxvtc

# spawn terminal in stand-alone window
alt + Return
  urxvtc -bg '#272E33' -cr '#83C092'

# custom launcher script
super + @space
    urxvtc -e sh -c "appcommander.sh;exit"

# zen-browser
super + z
	zen-browser https://nimplex.github.io/Minimal-StartPage/

# ranger
super + r
    urxvtc -g 120x35 -e ranger

# neovide
super + n 
  neovide

# help
super + ctrl + h
    urxvtc -g 120x30 -e sh -c "gum pager < /$HOME/.config/sxhkd/sxhkdrc;exit"

# alternatives

# firefox
super + ctrl + f
	firejail firefox

super + f 
  firefox

# gedit
super + x
    gedit

######################################
# MENUS
######################################

# Power
super + Delete
    urxvtc -g 45x11 -e sh -c "bspwm_powergmenu.sh;exit"

# Connections
super + i
    urxvtc -g 45x12 -e sh -c "bspwm_network.sh;exit"

# System
super + s
    urxvtc -g 45x11 -e sh -c "bspwm_system.sh;exit"

# Hidden windows
super + h
    urxvtc -g 120x30 -e sh -c "bspwm_hiddenwinmenu.sh;exit"

######################################
# LEMONBARS 
######################################

# Time 
super + ctrl + Return
    bar_clock.sh

# Current desktop
super + ctrl + d
    bar_desk.sh l

# Volume 
XF86AudioRaiseVolume
    bar_vol.sh InV

XF86AudioLowerVolume
    bar_vol.sh DeV
    
super + ctrl + v
    bar_vol.sh ShoV

XF86AudioMute
    bar_vol.sh MutV

# Battery  
super + ctrl + p 
   bar_bat.sh

######################################
# OTHER  
######################################

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

# quit/restart bspwm
super + ctrl + {q,r}
	bspc {quit,wm -r}






