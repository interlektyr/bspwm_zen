#
# Menus
#

# program launcher
super + @space
    urxvtc -e sh -c "appcommander.sh;exit"

# Power menu
super + Delete
    urxvtc -g 45x11 -e sh -c "bspwm_powergmenu.sh;exit"

# Network menu
super + i
    urxvtc -g 45x11 -e sh -c "bspwm_network.sh;exit"

# Network menu
super + s
